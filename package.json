{
  "name": "jobtracker",
  "version": "0.1.0",
  "private": true,
  "description": "Ghost job detector and application tracker: a browser extension backed by a crowd-sourced posting history.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev -w @jobtracker/api",
    "db:migrate": "npm run db:migrate -w @jobtracker/api"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
