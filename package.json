{
  "name": "jobtracker",
  "version": "0.1.0",
  "private": true,
  "description": "Ghost job detector and application tracker: a browser extension backed by a crowd-sourced posting history.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
