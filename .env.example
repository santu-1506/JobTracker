# API server
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info
DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5432/jobtracker_dev

# Plan given to new installs. Use "pro" locally to try reminders and analytics.
DEFAULT_PLAN=free

# Run the background worker inside the API process (handy for local dev).
WORKER_ENABLED=true

# Per-user request budget for POST /v1/sightings.
SIGHTINGS_PER_MINUTE=120

# Integration tests use a separate database. It is wiped on every run.
TEST_DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5432/jobtracker_test
