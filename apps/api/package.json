{
  "name": "@jobtracker/api",
  "version": "0.1.0",
  "private": true,
  "description": "JobTracker API: sightings, repost history, ghost scores and the application tracker.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --conditions=source src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx --conditions=source src/db/migrate-cli.ts",
    "db:migrate:prod": "node dist/db/migrate-cli.js",
    "worker": "tsx watch --conditions=source src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@jobtracker/core": "0.1.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
